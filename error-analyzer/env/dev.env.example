# Copy to dev.env and fill in. Loaded by Cloud Run (Terraform) or `--env-file` locally.
ENV=dev
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1
LLM_MODEL=gemini-2.5-pro

ALERTS_ON_OFF=ON
# Microsoft Teams incoming-webhook URL (preferred channel)
ALERT_TEAMS_CHANNEL=
# Email fallback (used only if Teams webhook is unset/failing)
ALERT_RECIPIENTS=edpsupport@example.com
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
