# Build-time env for DAG generation (prod). See dev.env for the model.
export ENV="prod"
export COMPOSER_DAGS_BUCKET="jsd-composer-prod"

export INGESTION_PROJECT="your-gcp-project-id"
export INGESTION_REGION="us-central1"
export RAW_PROJECT="your-gcp-project-id"
export WORK_PROJECT="your-gcp-project-id"
export CURATED_PROJECT="your-gcp-project-id"

export DATAFORM_REPO="edp-dataform"
export DATAFORM_PROJECT="your-gcp-project-id"
export DATAFORM_REGION="us-central1"
export DATAFORM_GIT_COMMITISH="main"

export DATAFLOW_BUCKET="jsd-dataflow-prod"
export DATAFLOW_REGION="us-central1"
export DATAFLOW_SUBNETWORK="regions/us-central1/subnetworks/composer-subnetwork-prod"
export INGESTION_SA="sa-jsd-composer-prod@your-gcp-project-id.iam.gserviceaccount.com"
