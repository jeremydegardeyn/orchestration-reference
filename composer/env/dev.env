# Build-time env for DAG generation (sourced by CI before framework/dag_builder.py).
# These values are baked into the generated DAGs via the env_override Jinja filter, so each
# environment gets DAGs compiled with its own project ids — same model as the Harness build.
export ENV="dev"
export COMPOSER_DAGS_BUCKET="jsd-composer-dev"

export INGESTION_PROJECT="your-gcp-project-id"
export INGESTION_REGION="us-central1"
export RAW_PROJECT="your-gcp-project-id"
export WORK_PROJECT="your-gcp-project-id"
export CURATED_PROJECT="your-gcp-project-id"

export DATAFORM_REPO="edp-dataform"
export DATAFORM_PROJECT="your-gcp-project-id"
export DATAFORM_REGION="us-central1"
export DATAFORM_GIT_COMMITISH="main"

export DATAFLOW_BUCKET="jsd-dataflow-dev"
export DATAFLOW_REGION="us-central1"
export DATAFLOW_SUBNETWORK="regions/us-central1/subnetworks/composer-subnetwork-dev"
export INGESTION_SA="sa-jsd-composer-dev@your-gcp-project-id.iam.gserviceaccount.com"
